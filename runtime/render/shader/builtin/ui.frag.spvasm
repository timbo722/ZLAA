; ui.frag.spvasm - the menu's pixels: vertex color x texture (both premultiplied alpha; untextured geometry uses
; a 1x1 white texture). Drawn into a UNORM view of the window image: RmlUi's colors are already sRGB values.
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint Fragment %main "main" %in_color %in_uv %color
               OpExecutionMode %main OriginUpperLeft
               OpDecorate %in_color Location 0
               OpDecorate %in_uv Location 1
               OpDecorate %color Location 0
               OpDecorate %tex DescriptorSet 0
               OpDecorate %tex Binding 0
       %void = OpTypeVoid
         %fn = OpTypeFunction %void
      %float = OpTypeFloat 32
        %v2f = OpTypeVector %float 2
        %v4f = OpTypeVector %float 4
        %img = OpTypeImage %float 2D 0 0 0 1 Unknown
       %simg = OpTypeSampledImage %img
     %p_simg = OpTypePointer UniformConstant %simg
        %tex = OpVariable %p_simg UniformConstant
    %p_in_v2 = OpTypePointer Input %v2f
    %p_in_v4 = OpTypePointer Input %v4f
   %p_out_v4 = OpTypePointer Output %v4f
   %in_color = OpVariable %p_in_v4 Input
      %in_uv = OpVariable %p_in_v2 Input
      %color = OpVariable %p_out_v4 Output
       %main = OpFunction %void None %fn
      %entry = OpLabel
          %c = OpLoad %v4f %in_color
         %uv = OpLoad %v2f %in_uv
          %s = OpLoad %simg %tex
          %t = OpImageSampleImplicitLod %v4f %s %uv
          %o = OpFMul %v4f %c %t
               OpStore %color %o
               OpReturn
               OpFunctionEnd
