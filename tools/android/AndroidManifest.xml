<?xml version="1.0" encoding="utf-8"?>
<!-- LAARecomp's Android app. The activity is SDL's own (org.libsdl.app.SDLActivity): it
     creates the window and loads libSDL3.so and libmain.so (our runtime + the game), then
     calls main(). Landscape only, no touch controls (the AYN Thor has buttons). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.laarecomp"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="35" />

    <!-- Vulkan 1.3 (the renderer needs it) and a gamepad -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="LAARecomp"
        android:hasCode="true"
        android:isGame="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name="org.libsdl.app.SDLActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
