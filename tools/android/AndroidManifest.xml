<?xml version="1.0" encoding="utf-8"?>
<!-- ZLAA's Android app. The activity is SDL's (org.libsdl.app.SDLActivity, as our ZLAAActivity, which adds a
     folder picker): it creates the window and loads libSDL3.so and libmain.so (our runtime), then calls main().
     Landscape only, no touch controls (the AYN Thor has buttons). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.zlaa"
    android:versionCode="100"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="35" />

    <!-- "All files access": the player's game files (6 GB) are read where they are, in a folder they choose -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Vulkan 1.3 (the renderer needs it) and a gamepad -->
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x403000" android:required="true" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:label="ZLAA"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:isGame="true"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- lets simpleperf (adb shell simpleperf record, option app) profile the game: no debugger, no root -->
        <profileable android:shell="true" />

        <activity
            android:name="io.github.zlaa.ZLAAActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
