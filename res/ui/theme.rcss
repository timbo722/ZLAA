/* theme.rcss - shared by all the menus: a dark warm palette (near-black, gold, parchment text; after Dusklight's,
   which the player liked) for Link's Awakening's night over Koholint, the rounded Nunito font, and the basics RmlUi leaves
   to us (it has no default style sheet: every element is inline until told otherwise). */
body {
    --font-body: Nunito;
    --font-icons: Material Symbols Rounded;

    --night-rgb: 11, 12, 9;
    --surface-rgb: 21, 22, 16;
    --gold-rgb: 233, 196, 106;
    --text-rgb: 224, 219, 200;
    --coral-rgb: 232, 120, 90;
    --night: rgb(var(--night-rgb));
    --gold: rgb(var(--gold-rgb));
    --gold-pale: #FEE685;
    --text: rgb(var(--text-rgb));
    --coral: rgb(var(--coral-rgb));
    --border: #92875B;
    --muted: #A6A09B;
    --good: #C8EF8E;
    --bad: #FFB4A2;

    --gap-xs: 4dp;
    --gap-sm: 8dp;
    --gap-md: 12dp;
    --gap-lg: 16dp;
    --gap-xl: 24dp;
    --pill: 999dp;

    font-family: var(--font-body);
    font-weight: normal;
    font-style: normal;
    font-size: 17dp;
    color: var(--text);
}

*, *:before, *:after {
    box-sizing: border-box;
}

div, p, heading, header, title-block, wordmark, game-title, tagline, menu-list, content, window, pane, tab-bar,
about, footer, row, status-chip, hints, sky, sea, island, hill, egg, halo, star {
    display: block;
}

p {
    line-height: 1.5;
    margin-bottom: var(--gap-md);
}

heading {
    font-weight: bold;
    font-size: 22dp;
    line-height: 1.3;
    margin-bottom: var(--gap-sm);
}

.hint {
    color: var(--muted);
}

b {
    font-weight: bold;
}

icon {
    width: 1em;
    height: 1em;
    font-family: var(--font-icons);
    font-weight: normal;
    line-height: 1;
    display: inline-block;
    vertical-align: middle;
}

icon.lock { decorator: text("&#xe897;" center center); }
icon.left { decorator: text("&#xe5cb;" center center); }
icon.right { decorator: text("&#xe5cc;" center center); }

/* a controller button in hints: a gold disc with its letter */
key-cap {
    display: inline-block;
    min-width: 24dp;
    height: 24dp;
    padding: 0 6dp;
    margin-right: var(--gap-xs);
    border-radius: 12dp;
    background-color: rgba(var(--gold-rgb), 90%);
    color: var(--night);
    font-weight: bold;
    font-size: 14dp;
    line-height: 24dp;
    text-align: center;
}

hints {
    font-size: 15dp;
    color: var(--muted);
}

hints span {
    margin-left: var(--gap-lg);
}

button, row {
    tab-index: auto;
    focus: auto;
    nav: auto;
    cursor: pointer;
}

button[disabled] {
    focus: none;
    tab-index: none;
    cursor: default;
}

scrollbarvertical {
    width: 6dp;
    margin-right: 2dp;
}

scrollbarvertical slidertrack {
    background-color: rgba(var(--text-rgb), 6%);
    border-radius: 3dp;
}

scrollbarvertical sliderbar {
    background-color: rgba(var(--gold-rgb), 50%);
    border-radius: 3dp;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}
