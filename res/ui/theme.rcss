/* theme.rcss - shared by all the menus: the "Koholint at night" palette (deep sea, sand, foam, a coral accent), the
   rounded Nunito font, and the basics RmlUi leaves to us (it has no default style sheet: every element is inline
   until told otherwise). */
body {
    --font-body: Nunito;
    --font-icons: Material Symbols Rounded;

    --sea-deep-rgb: 8, 20, 36;
    --sea-rgb: 14, 44, 64;
    --sand-rgb: 244, 217, 166;
    --foam-rgb: 232, 244, 242;
    --coral-rgb: 240, 138, 93;
    --sea-deep: rgb(var(--sea-deep-rgb));
    --sand: rgb(var(--sand-rgb));
    --foam: rgb(var(--foam-rgb));
    --coral: rgb(var(--coral-rgb));
    --muted: #8FA9B6;
    --good: #9BE3B4;
    --bad: #FFB4A2;

    --gap-xs: 4dp;
    --gap-sm: 8dp;
    --gap-md: 12dp;
    --gap-lg: 16dp;
    --gap-xl: 24dp;
    --pill: 999dp;

    font-family: var(--font-body);
    font-weight: normal;
    font-style: normal;
    font-size: 17dp;
    color: var(--foam);
}

*, *:before, *:after {
    box-sizing: border-box;
}

div, p, heading, header, title-block, wordmark, game-title, tagline, menu-list, content, window, pane, tab-bar,
about, footer, row, status-chip, hints {
    display: block;
}

p {
    line-height: 1.5;
    margin-bottom: var(--gap-md);
}

heading {
    font-weight: bold;
    font-size: 22dp;
    line-height: 1.3;
    margin-bottom: var(--gap-sm);
}

.hint {
    color: var(--muted);
}

b {
    font-weight: bold;
}

icon {
    width: 1em;
    height: 1em;
    font-family: var(--font-icons);
    font-weight: normal;
    line-height: 1;
    display: inline-block;
    vertical-align: middle;
}

icon.lock { decorator: text("&#xe897;" center center); }
icon.left { decorator: text("&#xe5cb;" center center); }
icon.right { decorator: text("&#xe5cc;" center center); }

/* a controller button in hints: a sand disc with its letter */
key-cap {
    display: inline-block;
    min-width: 24dp;
    height: 24dp;
    padding: 0 6dp;
    margin-right: var(--gap-xs);
    border-radius: 12dp;
    background-color: rgba(var(--sand-rgb), 90%);
    color: var(--sea-deep);
    font-weight: bold;
    font-size: 14dp;
    line-height: 24dp;
    text-align: center;
}

hints {
    font-size: 15dp;
    color: var(--muted);
}

hints span {
    margin-left: var(--gap-lg);
}

button, row {
    tab-index: auto;
    focus: auto;
    nav: auto;
    cursor: pointer;
}

button[disabled] {
    focus: none;
    tab-index: none;
    cursor: default;
}

scrollbarvertical {
    width: 6dp;
    margin-right: 2dp;
}

scrollbarvertical slidertrack {
    background-color: rgba(var(--foam-rgb), 6%);
    border-radius: 3dp;
}

scrollbarvertical sliderbar {
    background-color: rgba(var(--sand-rgb), 50%);
    border-radius: 3dp;
}

scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}
