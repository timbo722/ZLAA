<rml>
<head>
    <title>Build Game</title>
    <link type="text/rcss" href="theme.rcss" />
    <link type="text/rcss" href="window.rcss" />
</head>
<body>
    <window id="window" class="small build">
        <heading class="window-title"><icon class="build" />Build Game</heading>
        <p id="build-intro">Builds the game from your files, once. Please keep the app open until it's done (plugged in
        is best); if it closes, it carries on where it stopped next time.</p>
        <progress-track id="build-track"><progress-fill id="build-fill" /></progress-track>
        <build-line><build-percent id="build-percent" /><build-time id="build-time" /></build-line>
        <p id="build-detail" class="hint" />
        <menu-list>
            <button id="build-speed" />
            <p id="build-speed-help" class="hint speed-help" />
            <button id="build-go">Start</button>
            <button id="build-back">Back</button>
        </menu-list>
    </window>
</body>
</rml>
