/* start.rcss - the start screen: a night sea (sky fading into water, three slow waves), the title in the middle,
   rounded sand buttons under it, the game files' status as a chip at the bottom. No background art: none of the
   game's may come with us. */
body {
    width: 100%;
    height: 100%;
    background-color: var(--sea-deep);
}

sky {
    display: block;
    position: absolute;
    width: 100%;
    height: 70%;
    decorator: vertical-gradient(#081424FF #12384CFF);
}

sea {
    display: block;
    position: absolute;
    top: 70%;
    width: 100%;
    height: 30%;
    decorator: vertical-gradient(#0E2C40FF #050E1AFF);
}

/* a wave: a thin line of foam that fades out at both ends, drifting side to side */
wave {
    display: flex;
    position: absolute;
    height: 2dp;
}

half {
    display: block;
    flex: 1 1 0;
    height: 100%;
    decorator: horizontal-gradient(#E8F4F200 #E8F4F240);
}

half.out {
    decorator: horizontal-gradient(#E8F4F240 #E8F4F200);
}

wave.w1 { top: 12%; left: 8%; width: 46%; animation: 9s sine-in-out infinite alternate drift; }
wave.w2 { top: 26%; left: 40%; width: 52%; animation: 11s sine-in-out infinite alternate drift-back; }
wave.w3 { top: 50%; left: 14%; width: 38%; animation: 7s sine-in-out infinite alternate drift; }

@keyframes drift {
    from { transform: translateX(-30dp); }
    to { transform: translateX(30dp); }
}

@keyframes drift-back {
    from { transform: translateX(30dp); }
    to { transform: translateX(-30dp); }
}

wordmark {
    position: absolute;
    left: 40dp;
    top: 32dp;
    font-weight: 800;
    font-size: 16dp;
    color: var(--sand);
    letter-spacing: 2dp;
}

wordmark version-number {
    font-weight: normal;
    color: var(--muted);
    letter-spacing: 0;
    margin-left: var(--gap-sm);
}

title-block {
    position: absolute;
    top: 18%;
    width: 100%;
    text-align: center;
}

game-title {
    font-weight: 800;
    font-size: 64dp;
    line-height: 1.1;
    color: var(--foam);
    font-effect: shadow(0dp 4dp #04101C);
}

tagline {
    margin-top: var(--gap-sm);
    font-size: 18dp;
    color: var(--muted);
}

menu-list {
    position: absolute;
    top: 44%;
    left: 50%;
    width: 300dp;
    margin-left: -150dp;
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
}

menu-list button {
    display: block;
    height: 50dp;
    border-radius: 25dp;
    text-align: center;
    font-weight: bold;
    font-size: 24dp;
    line-height: 50dp;
    color: rgba(var(--foam-rgb), 85%);
    background-color: rgba(var(--foam-rgb), 0%);
}

menu-list button icon {
    width: 0;
    margin-right: 0;
    font-size: 24dp;
    opacity: 0;
}

menu-list button icon.play { decorator: text("&#xe037;" center center); }
menu-list button icon.gear { decorator: text("&#xe8b8;" center center); }
menu-list button icon.exit { decorator: text("&#xe9ba;" center center); }

menu-list button:hover,
menu-list button:focus-visible {
    color: var(--sea-deep);
    background-color: var(--sand);
}

menu-list button:focus-visible icon,
menu-list button:hover icon {
    width: 28dp;
    margin-right: var(--gap-xs);
    opacity: 1;
}

menu-list button:active {
    background-color: var(--coral);
}

menu-list button[disabled] {
    color: rgba(var(--foam-rgb), 30%);
    background-color: rgba(var(--foam-rgb), 0%);
}

status-chip {
    position: absolute;
    bottom: 36dp;
    left: 50%;
    width: 560dp;
    margin-left: -280dp;
    padding: 10dp var(--gap-xl);
    border-radius: 22dp;
    background-color: rgba(var(--sea-deep-rgb), 70%);
    border-width: 1dp;
    border-color: rgba(var(--foam-rgb), 12%);
    text-align: center;
    font-size: 17dp;
}

status-chip dot {
    display: inline-block;
    width: 10dp;
    height: 10dp;
    margin-right: var(--gap-sm);
    border-radius: 5dp;
    background-color: var(--muted);
}

status-chip[status=good] dot { background-color: var(--good); }
status-chip[status=bad] dot { background-color: var(--bad); }
status-chip[status=pending] dot { background-color: var(--coral); }

game-status-label {
    font-weight: bold;
}

game-version {
    margin-left: var(--gap-sm);
    color: var(--muted);
}

hints {
    position: absolute;
    right: 40dp;
    top: 30dp;
}

/* the start: everything rises into place, one after another */
.rise {
    opacity: 0;
    transform: translateY(12dp);
}

body.animate-in .rise {
    opacity: 1;
    transform: translateY(0dp);
}

.d0 { transition: opacity transform 0.4s 0.05s cubic-out; }
.d1 { transition: opacity transform 0.5s 0.15s cubic-out; }
.d2 { transition: opacity transform 0.4s 0.35s cubic-out; }
.d3 { transition: opacity transform 0.4s 0.42s cubic-out; }
.d4 { transition: opacity transform 0.4s 0.49s cubic-out; }
.d5 { transition: opacity transform 0.4s 0.65s cubic-out; }
