/* start.rcss - the start screen, laid out as Dusklight's prelaunch screen: a column of big buttons on the left,
   the game files' status bottom left, the version bottom right. No background art: none of the game's comes with us. */
body {
    width: 100%;
    height: 100%;
    font-size: var(--font-size-2xl);
    color: #FFFFFF;
    background-color: #070C0B;
}

backdrop {
    display: block;
    position: absolute;
    width: 100%;
    height: 100%;
    decorator: vertical-gradient(#16322DFF #050807FF);
}

shade {
    display: block;
    position: absolute;
    width: 100%;
    height: 100%;
    decorator: horizontal-gradient(#000000D0 #00000000);
}

menu {
    position: absolute;
    left: 96dp;
    top: 50%;
    transform: translateY(-55%);
    width: 520dp;
    display: flex;
    flex-direction: column;
    gap: 40dp;
}

hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
}

eyebrow {
    font-family: var(--font-family-display);
    font-size: var(--font-size-6xl);
    color: rgba(255, 255, 255, 85%);
}

game-title {
    font-family: var(--font-family-display);
    font-weight: bold;
    font-size: 64dp;
    line-height: 1.05;
    color: #FEE685;
    font-effect: glow(0dp 6dp 0dp 3dp #000000A0);
}

menu-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
}

menu-list button {
    width: 428dp;
    height: 54dp;
    padding: var(--space-sm) var(--space-lg);
    border-radius: var(--radius-panel);
    text-align: left;
    text-transform: uppercase;
    font-family: var(--font-family-heading);
    font-size: var(--font-size-6xl);
    line-height: 38dp;
    color: #FFFFFF;
    decorator: horizontal-gradient(#FEE68500 #FEE68500);
}

menu-list button.anim-done {
    transition: color 0.1s linear-in-out;
}

menu-list button:hover,
menu-list button:focus-visible {
    color: #000000;
    decorator: horizontal-gradient(#FEE685FF #FEE68500);
}

menu-list button[disabled] {
    opacity: 0.4;
    color: #FFFFFF;
    decorator: horizontal-gradient(#FEE68500 #FEE68500);
}

game-info {
    position: absolute;
    left: 96dp;
    bottom: 56dp;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-size: var(--font-size-4xl);
    font-effect: glow(0dp 4dp 0dp 4dp black);
}

game-status {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
}

game-status icon {
    display: none;
    width: 24dp;
    height: 24dp;
    font-size: var(--font-size-4xl);
}

game-status[status] icon { display: block; }
game-status[status=good] { color: var(--color-ready); }
game-status[status=bad] { color: var(--color-bad); }
game-status[status=pending] { color: var(--color-pending); }
game-status[status=good] icon { decorator: text("&#xe5ca;" center center); }
game-status[status=bad] icon { decorator: text("&#xe5cd;" center center); }
game-status[status=pending] icon { decorator: text("&#xe002;" center center); }

game-version {
    display: block;
    font-size: var(--font-size-2xl);
    color: var(--color-muted);
}

version-info {
    display: block;
    position: absolute;
    right: 96dp;
    bottom: 56dp;
    font-size: var(--font-size-2xl);
    color: var(--color-muted);
    font-effect: glow(0dp 4dp 0dp 4dp black);
}

controls-hint {
    display: block;
    position: absolute;
    right: 96dp;
    top: 48dp;
    font-size: var(--font-size-xl);
    color: var(--color-muted);
}

/* the start animation: each item rises into place, one after another */
.intro-item {
    opacity: 0;
    transform: translateY(10dp);
    transition: opacity transform 0.3s 0.1s cubic-in-out;
}

body.animate-in .intro-item {
    opacity: 1;
    transform: translateY(0dp);
}

.delay-0 { transition: opacity transform 0.3s 0.1s cubic-in-out; }
.delay-1 { transition: opacity transform 0.3s 0.2s cubic-in-out; }
.delay-2 { transition: opacity transform 0.3s 0.3s cubic-in-out; }
.delay-3 { transition: opacity transform 0.3s 0.4s cubic-in-out; }
.delay-4 { transition: opacity transform 0.3s 0.6s cubic-in-out; }
.delay-5 { transition: opacity transform 0.3s 0.7s cubic-in-out; }
