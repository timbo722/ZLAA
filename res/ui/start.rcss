/* start.rcss - the start screen: night over Koholint. A painted picture (images/night.png, made by
   tools/make_menu_art.py: a starry sky, Mt. Tamaranch with the Wind Fish's egg glowing on top, the island, the sea)
   with a little life on top: the egg's glow breathing, stars twinkling, now and then a shooting star, the light
   glinting on the water. The title and the menu on the left, where the picture is darkest. */
body {
    width: 100%;
    height: 100%;
    background-color: var(--night);
}

/* the picture and the egg's glow: both fill the screen the same way (cover, centred), so they stay lined up */
backdrop, egg-glow {
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
}

backdrop { decorator: image(images/night.png cover center center); }

egg-glow {
    decorator: image(images/glow.png cover center center);
    animation: 4.5s sine-in-out infinite alternate breathe;
}

@keyframes breathe {
    from { opacity: 0.25; }
    to { opacity: 1; }
}

sky, sea {
    display: block;
    position: absolute;
    left: 0;
    width: 100%;
}

sky { top: 0; height: 70%; }
sea { top: 70%; height: 30%; }

star {
    display: block;
    position: absolute;
    width: 3dp;
    height: 3dp;
    border-radius: 2dp;
    background-color: #FEF3C8;
}

star.big {
    width: 4dp;
    height: 4dp;
}

star.t1 { animation: 3.1s sine-in-out infinite alternate twinkle; }
star.t2 { animation: 4.3s sine-in-out infinite alternate twinkle; }
star.t3 { animation: 5.7s sine-in-out infinite alternate twinkle; }

@keyframes twinkle {
    from { opacity: 0.1; }
    to { opacity: 0.9; }
}

/* a shooting star: a short streak that crosses the upper sky once every 14 s */
shooting-star {
    display: block;
    position: absolute;
    left: 30%;
    top: 8%;
    width: 120dp;
    height: 2dp;
    decorator: horizontal-gradient(#FEF3C800 #FEF3C8E0);
    opacity: 0;
    transform: rotate(16deg);
    animation: 14s linear 3s infinite meteor;
}

@keyframes meteor {
    0% { opacity: 0; transform: translate(0dp, 0dp) rotate(16deg); }
    1% { opacity: 1; }
    6% { opacity: 0; transform: translate(260dp, 75dp) rotate(16deg); }
    100% { opacity: 0; transform: translate(260dp, 75dp) rotate(16deg); }
}

/* the light on the water: short gold lines in the egg's reflection that come and go */
sparkle {
    display: block;
    position: absolute;
    height: 2dp;
    decorator: horizontal-gradient(#FCD98C00 #FCD98C);
}
sparkle.t1 { animation: 2.3s sine-in-out infinite alternate glint; }
sparkle.t2 { animation: 3.1s sine-in-out infinite alternate glint; }
sparkle.t3 { animation: 1.7s sine-in-out infinite alternate glint; }

@keyframes glint {
    from { opacity: 0; }
    to { opacity: 0.55; }
}

/* the title: a small line above it, as a film's opening says who presents it */
hero {
    position: absolute;
    left: 96dp;
    top: 19%;
}

eyebrow {
    display: block;
    font-size: 17dp;
    color: var(--muted);
    letter-spacing: 1dp;
    margin-bottom: var(--gap-xs);
}

studio-name {
    font-weight: 800;
    color: var(--gold);
    letter-spacing: 2dp;
}

game-title {
    font-weight: 800;
    font-size: 64dp;
    line-height: 1.1;
    color: var(--gold-pale);
    font-effect: shadow(0dp 4dp #000000);
}

menu-list {
    position: absolute;
    top: 45%;
    left: 80dp;
    width: 300dp;
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
}

menu-list button {
    display: block;
    height: 50dp;
    padding: 0 16dp;
    border-radius: 25dp;
    font-weight: bold;
    font-size: 24dp;
    line-height: 50dp;
    color: var(--text);
    background-color: rgba(var(--gold-rgb), 0%);
}

menu-list button icon {
    width: 0;
    font-size: 24dp;
    opacity: 0;
}

menu-list button icon.play { decorator: text("&#xe037;" center center); }
menu-list button icon.gear { decorator: text("&#xe8b8;" center center); }
menu-list button icon.exit { decorator: text("&#xe9ba;" center center); }

menu-list button:hover,
menu-list button:focus-visible {
    color: var(--night);
    background-color: var(--gold);
}

menu-list button:focus-visible icon,
menu-list button:hover icon {
    width: 28dp;
    margin-right: var(--gap-xs);
    opacity: 1;
}

menu-list button:active {
    background-color: var(--gold-pale);
}

menu-list button[disabled] {
    color: rgba(var(--text-rgb), 30%);
    background-color: rgba(var(--gold-rgb), 0%);
}

status-chip {
    position: absolute;
    bottom: 36dp;
    left: 80dp;
    padding: 10dp 20dp;
    border-radius: 22dp;
    background-color: rgba(0, 0, 0, 55%);
    border-width: 1dp;
    border-color: rgba(var(--gold-rgb), 22%);
    font-size: 17dp;
}

status-chip dot {
    display: inline-block;
    width: 10dp;
    height: 10dp;
    margin-right: var(--gap-sm);
    border-radius: 5dp;
    background-color: var(--muted);
}

status-chip[status=good] dot { background-color: var(--good); }
status-chip[status=bad] dot { background-color: var(--bad); }
status-chip[status=pending] dot { background-color: var(--coral); }

game-status-label {
    font-weight: bold;
}

game-version {
    margin-left: var(--gap-sm);
    color: var(--muted);
}

/* the last session ended in a crash: where its report is (above the status chip) */
crash-note {
    display: none;
    position: absolute;
    left: 84dp;
    bottom: 92dp;
    max-width: 560dp;
    font-size: 15dp;
    color: var(--bad);
}

crash-note.shown { display: block; }

version-label {
    position: absolute;
    right: 40dp;
    bottom: 44dp;
    font-size: 15dp;
    color: var(--muted);
}

/* the start: everything rises into place, one after another */
.rise {
    opacity: 0;
    transform: translateY(12dp);
}

body.animate-in .rise {
    opacity: 1;
    transform: translateY(0dp);
}

.d0 { transition: opacity transform 0.6s 0.10s cubic-out; }
.d1 { transition: opacity transform 0.4s 0.35s cubic-out; }
.d2 { transition: opacity transform 0.4s 0.42s cubic-out; }
.d3 { transition: opacity transform 0.4s 0.49s cubic-out; }
.d4 { transition: opacity transform 0.4s 0.65s cubic-out; }
.d5 { transition: opacity transform 0.4s 0.75s cubic-out; }
