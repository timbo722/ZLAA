/* start.rcss - the start screen: night over Koholint. A dark warm sky with twinkling stars, Mt. Tamaranch's dark
   silhouette with the Wind Fish's egg glowing on top, the sea below with faint gold waves; the title and the menu on
   the left. All plain shapes: none of the game's art may come with us. */
body {
    width: 100%;
    height: 100%;
    background-color: var(--night);
}

sky {
    display: block;
    position: absolute;
    width: 100%;
    height: 70%;
    decorator: vertical-gradient(#07080AFF #15170FFF);
}

star {
    display: block;
    position: absolute;
    width: 3dp;
    height: 3dp;
    border-radius: 2dp;
    background-color: #FEF3C8;
    opacity: 0.3;
}

star.big {
    width: 4dp;
    height: 4dp;
}

star.t1 { animation: 3.1s sine-in-out infinite alternate twinkle; }
star.t2 { animation: 4.3s sine-in-out infinite alternate twinkle; }
star.t3 { animation: 5.7s sine-in-out infinite alternate twinkle; }

@keyframes twinkle {
    from { opacity: 0.15; }
    to { opacity: 0.9; }
}

/* the mountain and the egg, measured from the right edge: the hill's middle is 240 dp from it */
island {
    display: block;
    position: absolute;
    right: 0;
    bottom: 30%;
    width: 640dp;
    height: 420dp;
}

hill {
    display: block;
    position: absolute;
    right: -80dp;
    bottom: 0;
    width: 640dp;
    height: 290dp;
    border-radius: 320dp 320dp 0 0;
    background-color: #12140E;
    border-top-width: 1dp;
    border-color: rgba(var(--gold-rgb), 18%);
}

hill.small {
    right: 430dp;
    width: 360dp;
    height: 110dp;
    border-radius: 180dp 180dp 0 0;
    background-color: #0E100B;
    border-color: rgba(var(--gold-rgb), 10%);
}

/* the Wind Fish's egg on the top: seven circles along its axis, each a little wider than the one above (RmlUi
   draws no ellipses), make the egg's outline */
egg {
    display: block;
    position: absolute;
    right: 198dp;
    bottom: 286dp;
    width: 84dp;
    height: 116dp;
}

egg-part {
    display: block;
    position: absolute;
    background-color: #F4EDDA;
}

halo {
    display: block;
    position: absolute;
    background-color: #FEE685;
    opacity: 0.022;
}

halo.h1 { right: 180dp; bottom: 284dp; width: 120dp; height: 120dp; border-radius: 60dp; }
halo.h2 { right: 160dp; bottom: 264dp; width: 160dp; height: 160dp; border-radius: 80dp; }
halo.h3 { right: 140dp; bottom: 244dp; width: 200dp; height: 200dp; border-radius: 100dp; }
halo.h4 { right: 120dp; bottom: 224dp; width: 240dp; height: 240dp; border-radius: 120dp; }
halo.h5 { right: 100dp; bottom: 204dp; width: 280dp; height: 280dp; border-radius: 140dp; }
halo.h6 { right: 80dp; bottom: 184dp; width: 320dp; height: 320dp; border-radius: 160dp; }
halo.h7 { right: 55dp; bottom: 159dp; width: 370dp; height: 370dp; border-radius: 185dp; }
halo.h8 { right: 30dp; bottom: 134dp; width: 420dp; height: 420dp; border-radius: 210dp; }

glow {
    display: block;
    position: absolute;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    animation: 4s sine-in-out infinite alternate breathe;
}

sea {
    display: block;
    position: absolute;
    top: 70%;
    width: 100%;
    height: 30%;
    decorator: vertical-gradient(#0C1A1EFF #040607FF);
}

/* a wave: a thin gold line that fades out at both ends, drifting side to side */
wave {
    display: flex;
    position: absolute;
    height: 2dp;
}

half {
    display: block;
    flex: 1 1 0;
    height: 100%;
    decorator: horizontal-gradient(#E9C46A00 #E9C46A38);
}

half.out {
    decorator: horizontal-gradient(#E9C46A38 #E9C46A00);
}

wave.w1 { top: 14%; left: 52%; width: 40%; animation: 9s sine-in-out infinite alternate drift; }
wave.w2 { top: 34%; left: 30%; width: 50%; animation: 11s sine-in-out infinite alternate drift-back; }
wave.w3 { top: 58%; left: 60%; width: 34%; animation: 7s sine-in-out infinite alternate drift; }

@keyframes breathe {
    from { opacity: 0.55; }
    to { opacity: 1; }
}

@keyframes drift {
    from { transform: translateX(-30dp); }
    to { transform: translateX(30dp); }
}

@keyframes drift-back {
    from { transform: translateX(30dp); }
    to { transform: translateX(-30dp); }
}

wordmark {
    position: absolute;
    left: 40dp;
    top: 32dp;
    font-weight: 800;
    font-size: 16dp;
    color: var(--gold);
    letter-spacing: 2dp;
}

wordmark version-number {
    font-weight: normal;
    color: var(--muted);
    letter-spacing: 0;
    margin-left: var(--gap-sm);
}

title-block {
    position: absolute;
    left: 96dp;
    top: 21%;
}

game-title {
    font-weight: 800;
    font-size: 60dp;
    line-height: 1.1;
    color: var(--gold-pale);
    font-effect: shadow(0dp 4dp #000000);
}

tagline {
    margin-top: var(--gap-xs);
    font-size: 18dp;
    color: var(--muted);
}

menu-list {
    position: absolute;
    top: 45%;
    left: 80dp;
    width: 300dp;
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
}

menu-list button {
    display: block;
    height: 50dp;
    padding: 0 16dp;
    border-radius: 25dp;
    font-weight: bold;
    font-size: 24dp;
    line-height: 50dp;
    color: var(--text);
    background-color: rgba(var(--gold-rgb), 0%);
}

menu-list button icon {
    width: 0;
    font-size: 24dp;
    opacity: 0;
}

menu-list button icon.play { decorator: text("&#xe037;" center center); }
menu-list button icon.gear { decorator: text("&#xe8b8;" center center); }
menu-list button icon.exit { decorator: text("&#xe9ba;" center center); }

menu-list button:hover,
menu-list button:focus-visible {
    color: var(--night);
    background-color: var(--gold);
}

menu-list button:focus-visible icon,
menu-list button:hover icon {
    width: 28dp;
    margin-right: var(--gap-xs);
    opacity: 1;
}

menu-list button:active {
    background-color: var(--gold-pale);
}

menu-list button[disabled] {
    color: rgba(var(--text-rgb), 30%);
    background-color: rgba(var(--gold-rgb), 0%);
}

status-chip {
    position: absolute;
    bottom: 36dp;
    left: 80dp;
    padding: 10dp 20dp;
    border-radius: 22dp;
    background-color: rgba(0, 0, 0, 55%);
    border-width: 1dp;
    border-color: rgba(var(--gold-rgb), 22%);
    font-size: 17dp;
}

status-chip dot {
    display: inline-block;
    width: 10dp;
    height: 10dp;
    margin-right: var(--gap-sm);
    border-radius: 5dp;
    background-color: var(--muted);
}

status-chip[status=good] dot { background-color: var(--good); }
status-chip[status=bad] dot { background-color: var(--bad); }
status-chip[status=pending] dot { background-color: var(--coral); }

game-status-label {
    font-weight: bold;
}

game-version {
    margin-left: var(--gap-sm);
    color: var(--muted);
}

hints {
    position: absolute;
    right: 40dp;
    top: 30dp;
}

/* the start: everything rises into place, one after another */
.rise {
    opacity: 0;
    transform: translateY(12dp);
}

body.animate-in .rise {
    opacity: 1;
    transform: translateY(0dp);
}

.d0 { transition: opacity transform 0.4s 0.05s cubic-out; }
.d1 { transition: opacity transform 0.6s 0.15s cubic-out; }
.d2 { transition: opacity transform 0.4s 0.35s cubic-out; }
.d3 { transition: opacity transform 0.4s 0.42s cubic-out; }
.d4 { transition: opacity transform 0.4s 0.49s cubic-out; }
.d5 { transition: opacity transform 0.4s 0.65s cubic-out; }
