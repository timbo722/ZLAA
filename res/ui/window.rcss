/* window.rcss - the settings window and the pause menu: a dark rounded card with a thin gold edge. Settings: a header with the title
   and a pill-shaped page switcher, rows of settings (value between ‹ › arrows) beside a help pane. */
body {
    display: flex;
    width: 100%;
    height: 100%;
    padding: 36dp 56dp;
    background-color: #050604C0;
}

body.over-game {
    background-color: transparent;     /* (the paused game is dimmed already) */
}

window {
    display: flex;
    flex-flow: column;
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 1040dp;
    margin: auto;
    border-radius: 28dp;
    border-width: 1dp;
    border-color: rgba(146, 135, 91, 70%);
    background-color: rgb(var(--surface-rgb));  /* (solid: no blur behind it yet) */
    opacity: 0;
    transform: translateY(16dp);
    transition: opacity transform 0.22s cubic-out;
}

window[open] {
    opacity: 1;
    transform: translateY(0dp);
}

window.small {
    width: 400dp;
    height: auto;
    padding: 28dp;
}

heading.window-title {
    font-weight: 800;
    font-size: 30dp;
    color: var(--gold-pale);
    margin: 0;
}

heading.window-title icon {
    color: var(--gold);
    margin-right: var(--gap-sm);
}

icon.pause { decorator: text("&#xe034;" center center); }

header {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--gap-xl);
    padding: 20dp 28dp 12dp 28dp;
}

/* the pages: one pill track, the chosen page a gold pill in it */
tab-bar {
    display: flex;
    gap: var(--gap-xs);
    padding: 4dp;
    border-radius: 22dp;
    background-color: rgba(var(--text-rgb), 7%);
}

tab {
    display: block;
    padding: 0 18dp;
    height: 36dp;
    line-height: 36dp;
    border-radius: 18dp;
    font-weight: bold;
    font-size: 16dp;
    color: var(--muted);
    cursor: pointer;
}

tab:hover {
    color: var(--text);
    background-color: rgba(var(--text-rgb), 8%);
}

tab[selected] {
    color: var(--night);
    background-color: var(--gold);
}

close {
    display: block;
    margin-left: auto;
    width: 40dp;
    height: 40dp;
    border-radius: 20dp;
    font-family: var(--font-icons);
    font-size: 24dp;
    color: var(--muted);
    decorator: text("&#xe5cd;" center center);
    cursor: pointer;
}

close:hover {
    color: var(--text);
    background-color: rgba(var(--text-rgb), 10%);
}

content {
    display: flex;
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    padding: 0 12dp;
}

pane {
    display: flex;
    flex-flow: column;
    flex: 1 1 0;
    min-width: 0;
    padding: 12dp 16dp;
    gap: var(--gap-sm);
    overflow: hidden auto;
}

pane#help {
    flex: 0 0 38%;
    margin: 12dp 16dp 12dp 4dp;
    padding: 20dp;
    border-radius: 20dp;
    background-color: rgba(var(--text-rgb), 5%);
    font-size: 16dp;
    line-height: 1.6;
}

pane#help heading {
    color: var(--gold);
}

/* a setting: its name on the left, its value between arrows on the right */
row {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    height: 52dp;
    padding: 0 8dp 0 20dp;
    border-radius: 26dp;
    background-color: rgba(var(--text-rgb), 4%);
    nav: vertical;
}

row:hover,
row:focus-visible {
    background-color: rgba(var(--gold-rgb), 16%);
    border-width: 2dp;
    border-color: var(--gold);
}

row.fixed {
    opacity: 0.55;
}

row key {
    display: block;
    flex: 1 1 auto;
    font-weight: bold;
    font-size: 18dp;
    white-space: nowrap;
}

row value {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
    gap: var(--gap-xs);
    font-size: 18dp;
    color: var(--gold);
    white-space: nowrap;
}

row value icon {
    font-size: 22dp;
    color: var(--muted);
}

row:focus-visible value icon {
    color: var(--gold);
}

/* the About page: the whole width (no help pane), a title line, then short cards */
window.about pane#help {
    display: none;
}

about {
    display: block;
    font-size: 16dp;
    line-height: 1.55;
    padding: 4dp 8dp;
}

about-head {
    display: flex;
    align-items: baseline;
    gap: var(--gap-md);
    margin-bottom: var(--gap-sm);
}

about-title {
    font-weight: 800;
    font-size: 28dp;
    color: var(--gold-pale);
}

about-version {
    font-size: 15dp;
    color: var(--muted);
}

card {
    display: block;
    margin-top: var(--gap-md);
    padding: 14dp 18dp 4dp 18dp;
    border-radius: 18dp;
    background-color: rgba(var(--text-rgb), 5%);
}

card heading {
    font-size: 17dp;
    color: var(--gold);
    margin-bottom: var(--gap-xs);
}

p.legal {
    margin-top: var(--gap-lg);
    font-size: 14dp;
}

footer {
    flex: 0 0 auto;
    padding: 12dp 28dp 18dp 28dp;
    text-align: right;
}

/* the pause menu's buttons */
menu-list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    margin: 20dp 0 16dp 0;
}

menu-list button {
    display: block;
    height: 46dp;
    border-radius: 23dp;
    text-align: center;
    line-height: 46dp;
    font-weight: bold;
    font-size: 20dp;
    color: var(--text);
    background-color: rgba(var(--text-rgb), 6%);
    nav: vertical;
}

menu-list button:hover,
menu-list button:focus-visible {
    color: var(--night);
    background-color: var(--gold);
}

window.small hints {
    margin-top: var(--gap-sm);
    text-align: center;
}

window.small hints span {
    margin: 0 var(--gap-sm);
}

menu-list button.danger {
    color: var(--bad);
}

menu-list button.danger:hover,
menu-list button.danger:focus-visible {
    color: var(--night);
    background-color: var(--coral);
}
