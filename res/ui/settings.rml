<rml>
<head>
    <title>Settings</title>
    <link type="text/rcss" href="theme.rcss" />
    <link type="text/rcss" href="window.rcss" />
</head>
<body>
    <window id="window">
        <header>
            <heading class="window-title">Settings</heading>
            <tab-bar id="tab-bar" />
            <close id="close" />
        </header>
        <content>
            <pane id="rows" class="rows" />
            <pane id="help" />
        </content>
        <footer><hints><span><key-cap>L</key-cap><key-cap>R</key-cap>Page</span><span><key-cap>A</key-cap>Change</span><span><key-cap>B</key-cap>Back</span></hints></footer>
    </window>
</body>
</rml>
