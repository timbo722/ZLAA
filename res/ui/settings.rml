        <content>
            <pane id="rows" class="rows" />
            <pane id="help" />
        </content>
        <footer><b>L</b> / <b>R</b> Tabs &#160;&#160; <b>A</b> / <b>&#8592;</b> <b>&#8594;</b> Change &#160;&#160; <b>B</b> Back</footer>
    </window>
</body>
</rml>
