<rml>
<head>
    <title>Start</title>
    <link type="text/rcss" href="theme.rcss" />
    <link type="text/rcss" href="start.rcss" />
</head>
<body>
    <backdrop />
    <egg-glow />
    <sky>
        <star class="t1" style="left: 58%; top: 9%;" />
        <star class="t2" style="left: 66%; top: 21%;" />
        <star class="t3 big" style="left: 73%; top: 7%;" />
        <star class="t1" style="left: 41%; top: 26%;" />
        <star class="t2" style="left: 88%; top: 6%;" />
        <star class="t3" style="left: 34%; top: 11%;" />
        <star class="t2 big" style="left: 61%; top: 33%;" />
        <star class="t1" style="left: 52%; top: 18%;" />
        <star class="t3" style="left: 96%; top: 14%;" />
        <star class="t1" style="left: 27%; top: 5%;" />
        <shooting-star />
    </sky>
    <sea>
        <sparkle class="t1" style="left: 80.4%; top: 5%; width: 18dp;" />
        <sparkle class="t2" style="left: 81.6%; top: 14%; width: 24dp;" />
        <sparkle class="t3" style="left: 79.6%; top: 26%; width: 28dp;" />
        <sparkle class="t1" style="left: 82.2%; top: 37%; width: 26dp;" />
        <sparkle class="t2" style="left: 78.9%; top: 50%; width: 34dp;" />
        <sparkle class="t3" style="left: 81.0%; top: 63%; width: 32dp;" />
        <sparkle class="t1" style="left: 77.8%; top: 76%; width: 40dp;" />
        <sparkle class="t2" style="left: 82.4%; top: 87%; width: 36dp;" />
    </sea>
    <hero class="rise d0">
        <eyebrow><studio-name>LAARecomp</studio-name> presents</eyebrow>
        <game-title>Link's Awakening</game-title>
    </hero>
    <menu-list>
        <button id="play" class="rise d1"><icon class="play" />Play</button>
        <button id="settings" class="rise d2"><icon class="gear" />Settings</button>
        <button id="quit" class="rise d3"><icon class="exit" />Quit</button>
    </menu-list>
    <crash-note id="crash-note" class="rise d4" />
    <status-chip id="game-status" class="rise d4"><dot /><game-status-label id="game-status-label" /><game-version id="game-version" /></status-chip>
    <version-label class="rise d5">Version <version-number id="version" /></version-label>
</body>
</rml>
